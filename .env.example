# Backend Environment Variables
# Copy this file to .env and fill in your actual values.

# App
NODE_ENV=development
PORT=8000
FRONTEND_URL=http://localhost:5173

# Database
MONGODB_URI=mongodb://localhost:27017/aarambh_athletics_hub
# MONGODB_URI=mongodb+srv://username:password@cluster.mongodb.net/aarambh_athletics_hub

# Auth / JWT
JWT_SECRET=replace_with_a_secure_random_string_at_least_32_characters
JWT_EXPIRE_IN=1h
SALT_ROUND=10

# Email / SMTP
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USER=your_email@example.com
EMAIL_PASS=your_app_password
EMAIL_FROM=your_email@example.com

# Cloudinary / Storage
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret

# Redis / queue worker
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_URL=redis://127.0.0.1:6379

# Admin seed (used only by `npm run seed`)
# The seed refuses to run unless both are set, and never prints the password.
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=change_me_to_a_strong_password_1
# Optional overrides for the seeded admin
# ADMIN_NAME=Super Admin
# ADMIN_CONTACT=0000000000

# Optional tuning
# LOG_LEVEL=debug            # trace|debug|info|warn|error|fatal (defaults: debug in dev, info in prod)
# EMAIL_WORKER_CONCURRENCY=5 # number of email jobs processed in parallel by the worker

